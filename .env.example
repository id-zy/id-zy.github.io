# 构建时获取豆瓣书籍数据的服务端代理接口。
# 支持返回数组，或 { "books": [...] }。
# 每项可包含：id, title, author, year/pubdate, cover/cover_url/image, alt/url, summary。
DOUBAN_BOOKS_ENDPOINT=https://your-domain.example/api/douban/books
DOUBAN_MOVIES_ENDPOINT=https://your-domain.example/api/douban/movies

# 不配置代理时：电影直接抓公开「看过」页；图书先访问用户主页取 cookie，
# 再抓「读过」全部页。两者图片（书封面 + 电影海报）都在构建期下载到
# public/covers/ 本地化（豆瓣图床有防盗链，外链会 403），并由 astro.config.mjs
# 的 sync-douban-covers 集成在构建结束时同步进 dist。
# 抓取结果缓存在 .cache/，断网或被风控时自动回退缓存/示例数据。
DOUBAN_USER_ID=274633773

# ── 音乐（网易云）──
# 指定歌单 ID（歌单链接里 id= 后面那串数字）：只用这一个歌单，为空时页面显示空态。
NETEASE_PLAYLIST_ID=
# 没填歌单 ID 时，用用户 ID（user/home?id= 后面的数字）自动定位「我喜欢的音乐」，
# 再退到该账号首个可读歌单。系统歌单走 v6 接口 + 按 id 批量取详情（免登录可读）。
NETEASE_USER_ID=
# 一次渲染多少首（默认 100），歌单上千首时不要全量塞进页面。
NETEASE_TRACK_LIMIT=100
# 音频直链解析端点（前端播放时实时请求，签名地址有时效，不能写进静态页）。
# 默认公共 Meting 实例；自建 NeteaseCloudMusicApi 或 Meting 后改成自己的地址。
NETEASE_METING_ENDPOINT=https://api.injahow.cn/meting/

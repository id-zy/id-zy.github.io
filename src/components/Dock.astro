---
// 主页底部 Dock：本站全部栏目入口，只在主页显示。
import { url } from "../lib/url";

// 每个图标 = 彩色 squircle 渐变 + 内嵌白色 SVG 字形
const stroke = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
const darkGlyph = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="#101114" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;

const entries = [
  {
    label: "桌面",
    href: "/",
    bg: "linear-gradient(160deg,#6fa47e,#244d34)",
    glyph: stroke(`<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/>`),
  },
  {
    label: "本期策展",
    href: "/curation",
    bg: "linear-gradient(160deg,#d8a24a,#8d5d17)",
    glyph: stroke(`<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 5v14M16 5v14"/>`),
  },
  {
    label: "音乐",
    href: "/music",
    bg: "linear-gradient(160deg,#4f7b83,#28474d)",
    glyph: stroke(`<path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/>`),
  },
  {
    label: "电影",
    href: "/movie",
    bg: "linear-gradient(160deg,#6e1f2a,#38101a)",
    glyph: stroke(`<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 6v12M17 6v12M3 10h18M3 14h18"/>`),
  },
  {
    label: "图书",
    href: "/book",
    bg: "linear-gradient(160deg,#e8e4dc,#b5b0a6)",
    glyph: darkGlyph(`<path d="M12 6c-2-1.5-5-1.5-7 0v12c2-1.5 5-1.5 7 0 2-1.5 5-1.5 7 0V6c-2-1.5-5-1.5-7 0z"/><path d="M12 6v12"/>`),
  },
  {
    label: "题解",
    href: "/problems",
    bg: "linear-gradient(160deg,#7b5ea7,#3a2a58)",
    glyph: stroke(`<path d="M8 6l-5 6 5 6M16 6l5 6-5 6"/>`),
  },
  {
    label: "相册",
    href: "/gallery",
    bg: "linear-gradient(160deg,#4a4f57,#1c1f23)",
    glyph: stroke(`<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 16l-5-5-4 4-3-3-6 6"/>`),
  },
];
const pathname = Astro.url.pathname.replace(/\/$/, "");
const homePath = url("/").replace(/\/$/, "");
---

<nav class="dock" id="dock" aria-label="桌面应用">
  {
    entries.map((a) => (
      <a class:list={["dock-item", (a.href === "/" ? pathname === homePath : pathname.endsWith(a.href)) && "active"]} href={url(a.href)} aria-label={a.label} title={a.label}>
        <span class="squircle" style={`background:${a.bg}`} set:html={a.glyph} />
        <span class="dock-tip">{a.label}</span>
      </a>
    ))
  }
  <span class="dock-divider" aria-hidden="true"></span>
  <a
    class="dock-item dock-social"
    href="https://github.com/id-zy"
    target="_blank"
    rel="noreferrer"
    aria-label="GitHub：id-zy，在新标签页打开"
    title="GitHub"
  >
    <span class="squircle github-squircle">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.92c-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.91a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.06.36.32.68.95.68 1.91v2.8c0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/>
      </svg>
    </span>
    <span class="dock-tip">GitHub</span>
  </a>
</nav>

<script>
  // Dock 悬停放大（按与指针距离计算缩放，邻近图标一起放大）
  // 视图过渡后 Dock 是全新节点，需在 astro:page-load 重新绑定。
  const init = () => {
    const dock = document.getElementById("dock");
    if (!dock || dock.dataset.ready === "1") return;
    dock.dataset.ready = "1";
    const items = Array.from(dock.querySelectorAll<HTMLElement>(".dock-item"));
    dock.addEventListener("pointermove", (e) => {
      const rect = dock.getBoundingClientRect();
      items.forEach((it) => {
        const ir = it.getBoundingClientRect();
        const center = ir.left + ir.width / 2 - rect.left;
        const dist = Math.abs(e.clientX - rect.left - center);
        const scale = Math.max(1, 1.7 - dist / 95);
        it.style.setProperty("--scale", String(scale));
      });
    });
    dock.addEventListener("pointerleave", () => {
      items.forEach((it) => it.style.setProperty("--scale", "1"));
    });
  };
  document.addEventListener("astro:page-load", init);
</script>

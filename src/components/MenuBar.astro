---
import { url } from "../lib/url";
import { friends } from "../data/friends";
interface Props {
  app?: string;
}
const { app = "桌面" } = Astro.props;

const links = [
  { href: "/blog", label: "博客" },
  { href: "/works", label: "作品" },
  { href: "/about", label: "关于" },
];
// 当前路径已带 base，和 url() 的产物同源，可直接比较判断高亮
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="menubar">
  <div class="mb-left">
    <a class="mb-logo" href={url("/")} aria-label="返回桌面">◉</a>
    <span class="mb-app" id="mb-app">{app}</span>
    <nav class="mb-nav" aria-label="主导航">
      {
        links.map((l) => {
          const target = url(l.href);
          const on = here === target || here.startsWith(`${target}/`);
          return (
            <a href={target} aria-current={on ? "page" : undefined}>
              {l.label}
            </a>
          );
        })
      }
    </nav>
  </div>
  <div class="mb-right">
    <details class="mb-friends" id="mb-friends">
      <summary class="mb-friends-btn">友链</summary>
      <div class="mb-friends-panel" role="menu" aria-label="朋友们的站点">
        <p class="mb-friends-title">朋友们的站</p>
        {
          friends.map((f) => (
            <a class="mb-friend" href={f.link} target="_blank" rel="noopener noreferrer">
              <img
                src={f.avatar}
                alt={`${f.name} 的头像`}
                width="34"
                height="34"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
              <span class="mb-friend-text">
                <b>{f.name}</b>
                <small>{f.descr}</small>
              </span>
              <span class="mb-friend-arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </details>
    <button class="mb-search" type="button" data-cmd-open aria-label="快速前往，快捷键 Command 加 K">
      <span aria-hidden="true">⌕</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>
    <span class="mb-clock" id="mb-clock">--:--</span>
  </div>
</header>

<script>
  // 时钟：每次 tick 重新取元素，避免视图过渡后还写进已销毁的旧节点。
  const pad = (n: number) => String(n).padStart(2, "0");
  let timer = 0;

  const tick = () => {
    const clock = document.getElementById("mb-clock");
    if (!clock) return;
    const d = new Date();
    clock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
  };

  const init = () => {
    tick();
    if (!timer) timer = window.setInterval(tick, 10000);
  };

  document.addEventListener("astro:page-load", init);

  // 友链下拉：点外部 / Esc / 跳转前都要收起。
  const closeFriends = () => {
    const box = document.getElementById("mb-friends");
    if (box) box.removeAttribute("open");
  };

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    if (!e.target.closest("#mb-friends")) closeFriends();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeFriends();
  });

  document.addEventListener("astro:before-swap", closeFriends);
</script>

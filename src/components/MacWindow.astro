---
interface Props {
  title?: string;
  width?: string;
}
const { title = "", width = "min(900px, 94vw)" } = Astro.props;
---

<section class="mac-window" style={`--win-width:${width}`}>
  <div class="win-bar">
    <span class="lights"><i class="r"></i><i class="y"></i><i class="g"></i></span>
    <span class="win-title">{title}</span>
  </div>
  <div class="win-body">
    <slot />
  </div>
</section>

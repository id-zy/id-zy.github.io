---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  app="桌面"
  title="个人主页"
  bare
  dock
  description="个人站「此间」：博客、375 篇算法题解、观影与读书档案、音乐播放器与相册，548 页纯静态，无跟踪。"
>
  <section class="desktop-home" aria-label="桌面">
    <div class="desktop-clock-wrap">
      <h1 class="desktop-greeting">你好</h1>
      <div class="flip-clock" id="flip-clock" aria-label="当前时间">
        <div class="fdigit"><div class="fd-upper"><span>0</span></div><div class="fd-lower"><span>0</span></div><div class="fd-flip"><div class="fd-front"><span>0</span></div><div class="fd-back"><span>0</span></div></div></div>
        <div class="fdigit"><div class="fd-upper"><span>0</span></div><div class="fd-lower"><span>0</span></div><div class="fd-flip"><div class="fd-front"><span>0</span></div><div class="fd-back"><span>0</span></div></div></div>
        <span class="fd-colon">:</span>
        <div class="fdigit"><div class="fd-upper"><span>0</span></div><div class="fd-lower"><span>0</span></div><div class="fd-flip"><div class="fd-front"><span>0</span></div><div class="fd-back"><span>0</span></div></div></div>
        <div class="fdigit"><div class="fd-upper"><span>0</span></div><div class="fd-lower"><span>0</span></div><div class="fd-flip"><div class="fd-front"><span>0</span></div><div class="fd-back"><span>0</span></div></div></div>
        <span class="fd-colon">:</span>
        <div class="fdigit"><div class="fd-upper"><span>0</span></div><div class="fd-lower"><span>0</span></div><div class="fd-flip"><div class="fd-front"><span>0</span></div><div class="fd-back"><span>0</span></div></div></div>
        <div class="fdigit"><div class="fd-upper"><span>0</span></div><div class="fd-lower"><span>0</span></div><div class="fd-flip"><div class="fd-front"><span>0</span></div><div class="fd-back"><span>0</span></div></div></div>
      </div>
    </div>
  </section>
  <script>
    import { initClock } from "../scripts/clock";
    document.addEventListener("astro:page-load", () => initClock());
  </script>
</BaseLayout>

<style>
  .desktop-home {
    position: fixed;
    inset: var(--menubar-h) 0 var(--dock-h);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .desktop-clock-wrap {
    display: grid;
    justify-items: center;
    gap: 12px;
    transform: translateY(-2vh);
  }
  .desktop-greeting {
    margin: 0;
    color: var(--ink-strong);
    font-family: var(--font-read);
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 600;
    letter-spacing: .08em;
    text-shadow: 0 8px 28px rgba(0,0,0,.38);
  }
  .flip-clock { margin: 0; }
  @media (max-width: 620px) {
    .fdigit { --fh: 68px; --fw: 46px; font-size: 40px; }
    .flip-clock { gap: 5px; }
    .fd-colon { font-size: 28px; }
  }
</style>

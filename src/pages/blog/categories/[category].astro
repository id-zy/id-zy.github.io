---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { url } from "../../../lib/url";
import { slugOf } from "../../../lib/slug";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((cat) => ({
    params: { category: cat },
    props: {
      category: cat,
      posts: posts
        .filter((p) => p.data.category === cat)
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
      others: cats.filter((c) => c !== cat),
    },
  }));
}

const { category, posts, others } = Astro.props;
const iso = (d: Date | string) => (d instanceof Date ? d.toISOString().slice(0, 10) : String(d));
const hueMap: Record<string, number> = {
  // 与 components/PostDetail.astro 保持同一份色相表
  Java: 190, 数据库: 165, 数据结构: 275, BI: 30,
  微机原理: 250, 数据挖掘: 310, 离散数学: 220,
  分布式计算: 200, 人工智能: 285, 计算机安全: 0,
  "技术学习": 152, "题解": 205, "影评": 8, "读书笔记": 38,
  "创作": 8, "博客": 152, "未分类": 152, "题目": 275,
};
---

<BaseLayout shell={false} title={`分类 · ${category}`} orb description={`「${category}」分类下的全部文章，共 ${posts.length} 篇。`}>
  <div class="blog-page">

    <div class="blog-shell">
      <nav class="tax-nav">
        <a href={url("/blog")}>← 返回博客</a>
        <span>分类档案</span>
      </nav>

      <header class="tax-head">
        <h1>{category}</h1>
        <p>这个分类下共有 {posts.length} 篇文章。</p>
      </header>

      <p class="tag-cloud">
        {others.map((c: string) => (
          <a href={url(`/blog/categories/${encodeURIComponent(c)}`)}>{c}</a>
        ))}
      </p>

      <div class="post-list">
        {posts.map((p) => (
          <a class="post-row" href={url(`/blog/${slugOf(p.id)}`)} style={`--h:${hueMap[p.data.category] ?? 152}`}>
            <div class="post-main">
              <div class="post-meta">
                <time>{iso(p.data.date)}</time>
                <span class="post-cat">{p.data.category}</span>
              </div>
              <h2>{p.data.title}</h2>
              {p.data.summary && <p class="post-sum">{p.data.summary}</p>}
              <div class="post-tags">
                {(p.data.tags ?? []).map((t: string) => <span>#{t}</span>)}
              </div>
            </div>
            <div class="post-read">
              <span class="post-cover" aria-hidden="true"><em>{p.data.category}</em></span>
              <span class="post-go">读全文</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

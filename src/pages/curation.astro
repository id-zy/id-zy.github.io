---
import BaseLayout from "../layouts/BaseLayout.astro";
import { exhibit, theme } from "../data/curation";
import { url } from "../lib/url";

const filters = [
  { id: "all", label: "全部" },
  { id: "music", label: "耳畔" },
  { id: "movie", label: "银幕" },
  { id: "book", label: "书页" },
  ...(exhibit.photo ? [{ id: "photo", label: "底片" }] : []),
];
---

<BaseLayout
  app="策展"
  title={`${theme.title} · 策展`}
  bare
  orb
  description={`本期策展「${theme.title}」：${theme.subtitle}。从电影《${exhibit.movie.title}》、书《${exhibit.book.title}》与一首歌出发，看判断如何形成。`}
>
  <div class="mac-app-page">
    <section class="mac-app cur-app curation-archive">
      <div class="mac-canvas">
        <header class="archive-head">
          <a href={url("/")} class="archive-back">← 返回桌面</a>
          <p><b>2026 冬 · {theme.title}</b><span>{theme.tags.join("\u00a0\u00a0")}</span></p>
          <h1>{theme.title}</h1>
          <p class="archive-intro">导语：{theme.intro}</p>
        </header>
        <nav class="archive-filter" aria-label="筛选展品">
          {
            filters.map((filter, index) => (
              <button class:list={[index === 0 && "is-active"]} data-filter={filter.id}>
                [{filter.label}]
              </button>
            ))
          }
        </nav>
        <div class="archive-exhibits">
          <article class="archive-piece piece-music" data-kind="music">
            <span>耳畔 · 歌单曲目</span>
            <h2><a href={exhibit.music.url} target="_blank" rel="noopener noreferrer">{exhibit.music.title}</a></h2>
            <p>{exhibit.music.artist} · {exhibit.music.album === exhibit.music.title ? exhibit.music.duration : exhibit.music.album}</p>
            <small>{exhibit.music.note}</small>
          </article>
          <article
            class="archive-piece piece-movie"
            data-kind="movie"
            style={`--piece-image:url(${exhibit.movie.image})`}
          >
            <span>银幕 · 电影海报</span>
            <h2><a href={exhibit.movie.url} target="_blank" rel="noopener noreferrer">{exhibit.movie.title}</a></h2>
            <p>{exhibit.movie.director} · {exhibit.movie.year} · {exhibit.movie.duration}</p>
            <small>{exhibit.movie.note}</small>
          </article>
          <article class="archive-piece piece-book" data-kind="book">
            <span>书页 · 我的短评</span>
            <h2><a href={exhibit.book.url} target="_blank" rel="noopener noreferrer">{exhibit.book.title}</a></h2>
            <p>{exhibit.book.author} · {exhibit.book.year}</p>
            <blockquote>“{exhibit.book.quote}”</blockquote>
            <small>{exhibit.book.note}</small>
          </article>
        </div>
        <div class="archive-foot">
          {
            exhibit.photo ? (
              <figure
                class="archive-photo"
                data-kind="photo"
                style={`--piece-image:url(${exhibit.photo.image})`}
              >
                <figcaption>
                  <b>{exhibit.photo.title}</b>
                  <span>{exhibit.photo.location} · {exhibit.photo.date}</span>
                </figcaption>
              </figure>
            ) : (
              <figure class="archive-photo is-empty" aria-label="照片位等待填入">
                <figcaption>
                  <b>底片待冲洗</b>
                  <span>这一格留给自己的照片</span>
                </figcaption>
              </figure>
            )
          }
          <aside class="archive-tags">
            <b>关联标签</b>
            <p>{theme.tags.join("\u00a0\u00a0")}</p>
            <b>策展漫游</b>
            <p>{exhibit.line}</p>
          </aside>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  // 视图过渡后筛选按钮是新节点，需要每次导航重新绑定。
  const init = () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const pieces = [...document.querySelectorAll<HTMLElement>("[data-kind]")];
    if (!buttons.length || buttons[0].dataset.ready === "1") return;
    buttons[0].dataset.ready = "1";
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        buttons.forEach((item) => item.classList.toggle("is-active", item === button));
        const filter = button.dataset.filter;
        pieces.forEach((piece) => piece.classList.toggle("is-muted", filter !== "all" && piece.dataset.kind !== filter));
      }),
    );
  };
  document.addEventListener("astro:page-load", init);
</script>
